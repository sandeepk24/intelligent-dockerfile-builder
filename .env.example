# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=codellama:7b
OLLAMA_TIMEOUT=120
OLLAMA_HEALTH_TIMEOUT=5
OLLAMA_LIST_TIMEOUT=10

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Docker validation
DOCKER_BUILD_TIMEOUT=300
DOCKER_RUN_TIMEOUT=30
DOCKER_INSPECT_TIMEOUT=15
DOCKER_LOGS_TIMEOUT=10
DOCKER_REMOVE_TIMEOUT=30
DOCKER_BUILD_CPU_LIMIT=2
DOCKER_BUILD_MEMORY_LIMIT=2g
DOCKER_SANDBOX_DIR=/tmp/intelligent-dockerfile-sandbox
DOCKER_ALLOW_BUILDS=true
STARTUP_CHECK_SECONDS=8
HADOLINT_TIMEOUT=30
TRIVY_TIMEOUT=180
TRIVY_ENABLED=false

# Workspace (directory allowed for local project browsing)
# Defaults to the repo sample-projects directory when unset
# WORKSPACE_ROOT=/tmp/intelligent-dockerfile-workspace

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_FILE_COUNT=500

# AI repair
MAX_REPAIR_ATTEMPTS=3

# Database
DATABASE_URL=sqlite+aiosqlite:///./intelligent_dockerfile_builder.db
