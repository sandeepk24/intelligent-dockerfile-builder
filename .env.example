# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=codellama:7b
OLLAMA_TIMEOUT=120

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Docker validation
DOCKER_BUILD_TIMEOUT=300
DOCKER_BUILD_CPU_LIMIT=2
DOCKER_BUILD_MEMORY_LIMIT=2g

# Workspace (directory allowed for local project browsing)
WORKSPACE_ROOT=/tmp/ai-dockerfile-workspace

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_FILE_COUNT=500

# AI repair
MAX_REPAIR_ATTEMPTS=3

# Database
DATABASE_URL=sqlite:///./ai_dockerfile_builder.db
